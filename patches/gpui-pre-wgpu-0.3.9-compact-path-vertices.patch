+    /// Writes a path batch's vertex and per-path arrays into the shared
+    /// instance buffer and binds them together for the rasterization pass.
+    fn write_path_binding(
+        &mut self,
+        instance_offset: &mut u64,
+        vertices: &[PathRasterizationVertex],
+        infos: &[PathRasterizationInfo],
+    ) -> Result<InstanceBinding> {
+        let vertex_data = unsafe { Self::instance_bytes(vertices) };
+        let info_data = unsafe { Self::instance_bytes(infos) };
+        let align = self.instance_data_alignment.max(1);
+        // wgpu rejects zero-sized bindings.
+        let vertex_size = (vertex_data.len() as u64).max(16);
+        let info_size = (info_data.len() as u64).max(16);
+        // Reserve both allocations at once so a grow can't split them
+        // across two buffers.
+        let needed = vertex_size.next_multiple_of(align) + info_size + align;
+        let mut offset = (*instance_offset).next_multiple_of(align);
+        if offset + needed > self.instance_data_capacity {
+            self.grow_instance_data(needed)?;
+            offset = 0;
+        }
+        let vertex_offset = offset;
+        let info_offset = (vertex_offset + vertex_size).next_multiple_of(align);
+        *instance_offset = info_offset + info_size;
+
