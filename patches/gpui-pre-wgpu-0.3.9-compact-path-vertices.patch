+        let entry = |binding, offset, size| wgpu::BindGroupEntry {
+            binding,
+            resource: wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                buffer,
+                offset,
+                size: NonZeroU64::new(size),
+            }),
+        };
+        let bind_group = resources
+            .device
+            .create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("path_rasterization_bind_group"),
+                layout: &resources.bind_group_layouts.path_instances,
+                entries: &[
+                    entry(0, vertex_offset, vertex_size),
+                    entry(1, info_offset, info_size),
+                ],
+            });
+        Ok(InstanceBinding {
+            bind_group,
+            first_instance: 0,
+        })
+    }
