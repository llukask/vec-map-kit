+/// One copy of a glyph for [`Window::paint_glyph_instances`].
+#[derive(Debug, Clone, Copy)]
+pub struct GlyphInstance {
+    /// Where the glyph's baseline starts, in logical pixels.
+    pub origin: Point<Pixels>,
+    /// The colour to paint this copy in.
+    pub color: Hsla,
+    /// Clockwise rotation about `origin` (screen y points down).
+    pub rotation: crate::Radians,
+}
+
